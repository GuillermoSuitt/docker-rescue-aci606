# Copiar como .env y ajustar si es necesario:  cp .env.example .env
# Si no existe .env, compose.yaml usa estos mismos valores por defecto.

# Credenciales de PostgreSQL (las usan el servicio db y el backend)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=rescue123
POSTGRES_DB=appdb

# Puerto del host donde se publica el frontend (Nginx)
FRONTEND_PORT=8080
